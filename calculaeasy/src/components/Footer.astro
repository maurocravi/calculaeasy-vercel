---

---

<footer class="bg-slate-900 text-slate-300">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
            <!-- Brand Section -->
            <div class="space-y-4">
                <a href="/" class="inline-block">
                    <img
                        src="/custom-logo.svg"
                        alt="CalculaEasy"
                        class="h-8 w-auto"
                    />
                </a>
                <p class="text-sm text-slate-400 leading-relaxed">
                    Calculadoras fáciles y precisas para sueldo e impuestos en
                    Uruguay. Resultados rápidos y claros.
                </p>
            </div>

            <!-- Quick Links -->
            <div class="space-y-4">
                <h4
                    class="text-sm font-semibold text-white uppercase tracking-wider"
                >
                    Enlaces
                </h4>
                <ul class="space-y-3">
                    <li>
                        <a
                            href="/sobre-nosotros"
                            class="text-sm hover:text-indigo-400 transition-colors duration-200 inline-flex items-center group"
                        >
                            Sobre Nosotros
                        </a>
                    </li>
                    <li>
                        <a
                            href="/contacto"
                            class="text-sm hover:text-indigo-400 transition-colors duration-200 inline-flex items-center group"
                        >
                            Contacto
                        </a>
                    </li>
                    <li>
                        <a
                            href="/politica-de-privacidad"
                            class="text-sm hover:text-indigo-400 transition-colors duration-200 inline-flex items-center group"
                        >
                            Política de Privacidad
                        </a>
                    </li>
                    <li>
                        <a
                            href="/terminos-de-uso"
                            class="text-sm hover:text-indigo-400 transition-colors duration-200 inline-flex items-center group"
                        >
                            Términos de Uso
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Info Section -->
            <div class="space-y-4">
                <h4
                    class="text-sm font-semibold text-white uppercase tracking-wider"
                >
                    Información
                </h4>
                <p class="text-sm text-slate-400 leading-relaxed">
                    Basadas en criterios y referencias públicas de Uruguay,
                    actualizadas periódicamente.
                </p>

                <p class="text-xs text-slate-500">
                    *Los resultados son estimaciones. Ver Términos de Uso.
                </p>
                <!-- <p class="text-xs text-slate-500">
                    Última actualización: {new Date().getFullYear()}
                </p> -->
            </div>
        </div>

        <!-- Bottom Bar -->
        <div
            class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-4"
        >
            <div class="space-y-1 text-center sm:text-left">
                <p class="text-sm text-slate-500">
                    © {new Date().getFullYear()} CalculaEasy. Todos los derechos reservados.
                </p>
                <p class="text-xs text-slate-600">
                    Ilustraciones por <a
                        href="https://storyset.com"
                        target="_blank"
                        rel="noopener"
                        class="hover:text-indigo-400 transition-colors duration-200 underline underline-offset-2"
                        >Storyset</a
                    >
                </p>
            </div>
            <p class="text-xs text-slate-600">Hecho con 💜 en Uruguay</p>
        </div>
    </div>
</footer>
