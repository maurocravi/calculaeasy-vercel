---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { breadcrumbSchema } from "../lib/seo/breadcrumbSchema";

const breadcrumbs = [
    { name: "Inicio", url: "/" },
    { name: "Calculadoras", url: "/calculadoras" },
];

const currentYear = new Date().getFullYear();

const tools = [
    {
        title: "Calculadora sueldo líquido",
        description: "Pasá de nominal a lo que te llega al bolsillo.",
        icon: "/ilustraciones/sueldo.svg",
        href: "/calculadoras/sueldo-liquido-uruguay",
    },
    {
        title: "Calculadora aguinaldo",
        description: "Estimá cuánto vas a cobrar en junio o diciembre.",
        icon: "/ilustraciones/aguinaldo.svg",
        href: "/calculadoras/aguinaldo-uruguay",
    },
    {
        title: "Calculadora salario vacacional",
        description: "Para planificar mejor tu descanso.",
        icon: "/ilustraciones/vacacional.svg",
        href: "/calculadoras/salario-vacacional-uruguay",
    },
    {
        title: "Horas extra",
        description: "Calculá el valor de tus horas simples y dobles.",
        icon: "/ilustraciones/horas-extra.svg",
        href: "/calculadoras/horas-extra-uruguay",
    },
    {
        title: "IVA",
        description: "Agregá o descontá el IVA básico o mínimo.",
        icon: "/ilustraciones/iva.svg",
        href: "/calculadoras/iva-uruguay",
    },
    {
        title: "Conversor de sueldo",
        description: "Convertí tu sueldo mensual a hora, día, semana y año.",
        icon: "/ilustraciones/conversor.svg",
        href: "/calculadoras/conversor-sueldo-uruguay",
    },
    {
        title: "Indemnización por despido",
        description: "Calculá tu indemnización por despido en Uruguay.",
        icon: "/ilustraciones/severance.svg",
        href: "/calculadoras/indemnizacion-despido-uruguay",
    },
];

const faqs = [
    {
        question: "¿Las calculadoras son gratis?",
        answer: "Sí. Todas las calculadoras de CalculaEasy son gratuitas y no necesitás registrarte ni dejar tus datos. Ingresás los valores, obtenés el resultado al instante y listo.",
    },
    {
        question: `¿Están actualizadas a la normativa de ${currentYear}?`,
        answer: `Sí. Los cálculos de sueldo líquido, aguinaldo, IRPF y aportes usan los valores y franjas vigentes en ${currentYear} (BPS y DGI). Cuando cambian las tablas oficiales —normalmente en enero— actualizamos las calculadoras.`,
    },
    {
        question: "¿De dónde salen los criterios de cálculo?",
        answer: "Nos basamos en la normativa laboral y tributaria uruguaya: los aportes al BPS (jubilatorio, FONASA, FRL), las franjas del IRPF de la DGI y la Ley de Despido. Cada calculadora explica en detalle cómo hace el cálculo en su propia página.",
    },
    {
        question: "¿Sirven si soy monotributista o unipersonal?",
        answer: "Las calculadoras de sueldo están pensadas para trabajadores dependientes (con relación de dependencia). Si sos independiente, unipersonal o monotributista, tu régimen de aportes es distinto y los resultados no van a coincidir con tu situación real.",
    },
    {
        question: "¿Los resultados son exactos?",
        answer: "Son estimaciones muy cercanas para el caso general dependiente, pero pueden variar según tu situación particular (cajas paraestatales, régimen ficto, partidas no gravadas, etc.). Para montos oficiales, siempre confirmá con tu recibo de sueldo o un contador.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
        },
    })),
};

const schema = [breadcrumbSchema(breadcrumbs), faqSchema];
---

<Layout
    title="Calculadoras Uruguay {{year}} - Sueldo, Impuestos y Más"
    description="Todas las calculadoras de CalculaEasy: sueldo líquido, aguinaldo, salario vacacional, IVA, horas extra y más. Herramientas gratuitas para Uruguay."
    canonical="https://calculaeasy.com/calculadoras"
    schema={schema}
>
    <div class="bg-indigo-50 min-h-screen py-12">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
            <Breadcrumbs items={breadcrumbs} />

            <div class="text-center mb-12">
                <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
                    Todas las Calculadoras
                </h1>
                <p class="text-slate-600 text-lg max-w-2xl mx-auto">
                    Herramientas gratuitas para calcular sueldo, impuestos y
                    beneficios laborales en Uruguay.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    tools.map((tool) => (
                        <a
                            href={tool.href}
                            class="group block p-8 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-indigo-100 transition-all duration-300 transform hover:-translate-y-1"
                        >
                            <div class="flex items-start justify-between mb-4">
                                <img
                                    src={tool.icon}
                                    alt={tool.title}
                                    class="w-16 h-16 sm:w-20 sm:h-20"
                                />
                                <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center group-hover:bg-indigo-50 transition-colors">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="w-4 h-4 text-slate-400 group-hover:text-indigo-600 transition-colors"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 5l7 7-7 7"
                                        />
                                    </svg>
                                </div>
                            </div>
                            <h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-indigo-600 transition-colors">
                                {tool.title}
                            </h2>
                            <p class="text-slate-600">{tool.description}</p>
                        </a>
                    ))
                }
            </div>

            <!-- Contenido: guía por categorías -->
            <section class="max-w-4xl mx-auto mt-16">
                <h2
                    class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4"
                >
                    ¿Qué podés calcular en CalculaEasy?
                </h2>
                <p class="text-slate-700 leading-relaxed mb-8">
                    Reunimos en un solo lugar las cuentas que todo trabajador en
                    Uruguay necesita hacer alguna vez: cuánto cobrás de verdad,
                    cuánto te corresponde de aguinaldo o vacacional, y cuánto pagás
                    de impuestos. Todas son gratuitas, no piden registro y explican
                    paso a paso cómo llegan al resultado.
                </p>

                <div class="space-y-8">
                    <div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3"
                        >
                            Sueldo y remuneración
                        </h3>
                        <p class="text-slate-700 leading-relaxed">
                            Empezá por la <a
                                href="/calculadoras/sueldo-liquido-uruguay"
                                class="text-indigo-600 font-medium hover:underline"
                                >calculadora de sueldo líquido</a
                            >, que convierte tu sueldo nominal en lo que
                            realmente te llega al bolsillo descontando aportes
                            jubilatorios, FONASA e IRPF. Si querés saber cuánto
                            ganás por hora, día o año, el <a
                                href="/calculadoras/conversor-sueldo-uruguay"
                                class="text-indigo-600 font-medium hover:underline"
                                >conversor de sueldo</a
                            > te lo desglosa al instante. Y si hacés horas de más,
                            la <a
                                href="/calculadoras/horas-extra-uruguay"
                                class="text-indigo-600 font-medium hover:underline"
                                >calculadora de horas extra</a
                            > te dice cuánto valen tus horas simples, dobles y en
                            feriados.
                        </p>
                    </div>

                    <div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3"
                        >
                            Beneficios laborales
                        </h3>
                        <p class="text-slate-700 leading-relaxed">
                            El <a
                                href="/calculadoras/aguinaldo-uruguay"
                                class="text-indigo-600 font-medium hover:underline"
                                >aguinaldo</a
                            > (sueldo anual complementario) se cobra en junio y
                            diciembre: estimá cuánto te toca según los meses
                            trabajados. El <a
                                href="/calculadoras/salario-vacacional-uruguay"
                                class="text-indigo-600 font-medium hover:underline"
                                >salario vacacional</a
                            > es esa suma extra para disfrutar la licencia, y
                            podés calcular el monto líquido según tus días. Si te
                            desvincularon, la <a
                                href="/calculadoras/indemnizacion-despido-uruguay"
                                class="text-indigo-600 font-medium hover:underline"
                                >calculadora de indemnización por despido</a
                            > estima cuánto te corresponde según tu antigüedad y
                            salario.
                        </p>
                    </div>

                    <div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3"
                        >
                            Impuestos
                        </h3>
                        <p class="text-slate-700 leading-relaxed">
                            La <a
                                href="/calculadoras/iva-uruguay"
                                class="text-indigo-600 font-medium hover:underline"
                                >calculadora de IVA</a
                            > te permite agregar o descontar el impuesto de una
                            compra o venta, tanto con la tasa básica (22 %) como
                            con la mínima (10 %). Útil para presupuestar,
                            facturar o simplemente entender cuánto de un precio es
                            impuesto.
                        </p>
                    </div>
                </div>
            </section>

            <!-- FAQ general -->
            <section class="max-w-4xl mx-auto mt-16">
                <h2
                    class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6"
                >
                    Preguntas frecuentes
                </h2>
                <div class="space-y-4">
                    {
                        faqs.map((faq) => (
                            <details class="group bg-white rounded-2xl open:shadow-lg open:shadow-indigo-50/50 transition-all duration-300 border border-slate-100">
                                <summary class="flex justify-between items-center font-medium cursor-pointer list-none py-5 px-6 text-lg text-slate-800">
                                    <span>{faq.question}</span>
                                    <span class="transition group-open:rotate-180">
                                        <svg
                                            fill="none"
                                            height="24"
                                            stroke="currentColor"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            viewBox="0 0 24 24"
                                            width="24"
                                        >
                                            <path d="M6 9l6 6 6-6" />
                                        </svg>
                                    </span>
                                </summary>
                                <div class="text-slate-600 px-6 pb-6 pt-0 leading-relaxed">
                                    {faq.answer}
                                </div>
                            </details>
                        ))
                    }
                </div>
            </section>
        </div>
    </div>
</Layout>
